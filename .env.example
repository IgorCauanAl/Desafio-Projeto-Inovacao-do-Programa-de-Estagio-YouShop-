# Copie para .env antes de usar o Docker Compose (opcional).
# Porta exposta no host (o container sempre escuta na 8080).
HOST_PORT=8080

# Opcional: sem chave, a aplicacao roda com o fallback deterministico.
# OPENAI_API_KEY=sk-...
# YOUSHOP_AI_OPENAI_MODEL=gpt-4o-mini

# Fuso horario do container.
TZ=UTC
